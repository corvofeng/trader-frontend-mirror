# ============================================================
# YHTrader Web Push Server —— Environment Config
# ============================================================
# 生成方式：
#   1) cd push_server
#   2) 安装依赖：pip install -r requirements.txt
#   3) 运行 python generate_vapid_keys.py，把输出贴到下面两行
# ============================================================

# VAPID 公钥（前端 navigator.serviceWorker.pushManager.subscribe 用）
# 必须与下方 VAPID_PRIVATE_KEY 配对
VAPID_PUBLIC_KEY=请运行 generate_vapid_keys.py 生成后粘贴到这里

# VAPID 私钥（仅服务端持有，用于给 Web Push 请求签名）
# 千万不要泄露或提交到公开仓库
VAPID_PRIVATE_KEY=请运行 generate_vapid_keys.py 生成后粘贴到这里

# VAPID 联系邮箱 —— 推送服务出现问题时浏览器厂商会通过这个邮箱联系你
VAPID_EMAIL=admin@example.com

# 服务监听端口
PORT=8787

# 订阅持久化存储目录（默认 push_server/data）
STORAGE_DIR=./data

# 允许的 CORS Origin（多个用英文逗号分隔）
# 生产部署填你自己的域名，如 https://stock.in.corvo.fun
CORS_ORIGINS=https://stock.in.corvo.fun,http://localhost:5173,http://localhost:5174

# 轮询 RSS 的间隔（秒，默认 30）
RSS_POLL_INTERVAL_SECONDS=30

# 后端代理前端 API 的 Base URL
# 开发可填 http://localhost:5173，生产填 https://stock.in.corvo.fun
UPSTREAM_BASE_URL=https://stock.in.corvo.fun

# 认证：前端订阅 / 管理接口使用的共享密钥
# 如果留空，则关闭认证（仅本地联调时使用！）
ADMIN_SHARED_SECRET=
